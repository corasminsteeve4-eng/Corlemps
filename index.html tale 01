.dot{display:inline-block;width:12px;height:12px;border-radius:50%;background:var(--good);vertical-align:middle;animation:blink 1.6s infinite}
.dot.off{background:var(--bad);animation:none}
@keyframes blink{50%{opacity:.35}}
.alertbar{display:block;width:100%;border:0;border-bottom:3px solid var(--line);cursor:pointer;font:inherit;font-weight:700}
.eq{font-size:12px;color:var(--muted);margin-top:6px;text-align:right}
.receipt .rlogo{display:block;margin:0 auto 6px;max-width:72px;max-height:72px;object-fit:contain}
label.btn{display:block;text-align:center;cursor:pointer;background:var(--paper);color:var(--ink);font-size:13px}
