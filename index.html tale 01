<style>
:root{
  --bg:#E4DBFF;--paper:#FFFFFF;--ink:#14101F;--muted:#5E5578;--line:#14101F;--sh:#14101F;--field:#F3EEFF;
  --violet:#7A4DFF;--pink:#FF5CA8;--lime:#C6F432;--sky:#6EC8FF;--sun:#FFD84D;--dark:#14101F;--bad:#E0245E;--good:#0B8F5A;
  --display:'Unbounded','Arial Black',system-ui,sans-serif;--body:'DM Sans',system-ui,sans-serif;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#150F2A;--paper:#231A40;--ink:#F4EFFF;--muted:#B3A8D6;--line:#9B86E8;--sh:#05030C;--field:#2D2350;--bad:#FF6B97;--good:#4BE0A0}
}
:root[data-theme="dark"]{--bg:#150F2A;--paper:#231A40;--ink:#F4EFFF;--muted:#B3A8D6;--line:#9B86E8;--sh:#05030C;--field:#2D2350;--bad:#FF6B97;--good:#4BE0A0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
html,body{margin:0}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.4;-webkit-tap-highlight-color:transparent}
body[data-sec="bou"]{--acc:var(--lime)}
body[data-sec="fam"]{--acc:var(--sky)}
body[data-sec="hop"]{--acc:var(--pink)}
body[data-sec="hot"]{--acc:#FF9A3D}
body[data-sec="mar"]{--acc:var(--sun)}
body[data-sec="lek"]{--acc:#B79CFF}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--violet);outline-offset:3px}

.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;max-width:1200px;margin:0 auto}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.logo{flex:none;width:46px;height:46px;border-radius:14px;background:var(--violet);color:#fff;border:3px solid var(--line);box-shadow:3px 3px 0 var(--sh);display:grid;place-items:center;font:800 22px var(--display);transform:rotate(-6deg)}
.brand h1{font:800 clamp(16px,4.4vw,24px) var(--display);margin:0;letter-spacing:-.02em;line-height:1.1}
.brand small{color:var(--muted);display:block;font-size:13px;margin-top:2px}
.stats{display:flex;gap:10px;flex:none}
.stat{background:var(--sun);color:var(--dark);border:3px solid var(--line);border-radius:14px;box-shadow:3px 3px 0 var(--sh);padding:6px 12px;text-align:right}
.stat b{font:800 16px var(--display);display:block}
.stat span{font-size:12px;font-weight:500}
.stat.alt{background:var(--paper);color:var(--ink)}

.app{display:grid;grid-template-columns:1fr 390px;gap:20px;padding:6px 16px 24px;max-width:1200px;margin:0 auto}
.card{background:var(--paper);border:3px solid var(--line);border-radius:20px;box-shadow:5px 5px 0 var(--sh)}

.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.tab{border:3px solid var(--line);background:var(--paper);border-radius:16px;padding:12px 6px;font:700 15px var(--display);box-shadow:3px 3px 0 var(--sh);display:flex;flex-direction:column;align-items:center;gap:2px;transition:transform .1s,box-shadow .1s}
.tab .i{font-size:24px}
.tab span:last-child{font-size:clamp(12px,3.2vw,15px)}
.tab[aria-pressed="true"]{background:var(--acc);color:var(--dark);transform:translate(2px,2px);box-shadow:1px 1px 0 var(--sh)}

.catalog{padding:16px}
.search{width:100%;padding:13px 16px;border:3px solid var(--line);border-radius:14px;background:var(--field);color:var(--ink);font-size:16px;font-family:var(--body)}
.search::placeholder{color:var(--muted)}
.cats{display:flex;gap:8px;overflow-x:auto;padding:14px 4px 8px}
.cat{flex:none;border:2px solid var(--line);background:var(--paper);padding:7px 14px;border-radius:999px;font-weight:700;font-size:14px}
.cat[aria-pressed="true"]{background:var(--acc);color:var(--dark)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:12px;margin-top:8px}
.prod{position:relative;text-align:left;border:3px solid var(--line);background:var(--paper);border-radius:16px;padding:12px;display:flex;flex-direction:column;gap:3px;min-height:130px;box-shadow:3px 3px 0 var(--sh);transition:transform .1s,box-shadow .1s}
.prod:active:not([disabled]){transform:translate(3px,3px);box-shadow:0 0 0 var(--sh)}
.prod .e{font-size:28px;line-height:1}
.prod .n{font-weight:700;font-size:14px;margin-top:4px}
.prod .p{font:800 14px var(--display);color:var(--ink)}
.prod .s{font-size:12px;color:var(--muted)}
.prod .s.low{color:var(--bad);font-weight:700}
.prod .x{font-size:12px;font-weight:700;color:var(--muted)}
.prod .x.soon{color:#B45309}
:root[data-theme="dark"] .prod .x.soon{color:#FFB357}
.prod .x.gone{color:var(--bad)}
.rx{position:absolute;top:8px;right:8px;background:var(--pink);color:var(--dark);border:2px solid var(--line);border-radius:8px;font:800 11px var(--display);padding:2px 6px;transform:rotate(6deg)}
.prod[disabled]{opacity:.5;cursor:not-allowed;box-shadow:none}
.none{grid-column:1/-1;text-align:center;color:var(--muted);padding:28px 8px}

.cart{padding:16px;align-self:start;position:sticky;top:12px;display:flex;flex-direction:column}
.cart h2{font:800 18px var(--display);margin:0 0 10px;display:flex;justify-content:space-between;align-items:baseline}
.cart h2 small{font:500 13px var(--body);color:var(--muted)}
.held{display:flex;gap:6px;flex-wrap:wrap}
.held button{border:2px dashed var(--line);background:transparent;border-radius:10px;padding:4px 10px;font-size:13px;font-weight:700;margin-bottom:8px}
.lines{min-height:80px;max-height:280px;overflow-y:auto}
.empty{color:var(--muted);padding:22px 4px;text-align:center}
.line{display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;padding:9px 0;border-bottom:2px dashed var(--line)}
.line .nm{font-weight:700}
.line .un{font-size:12px;color:var(--muted)}
.tag{display:inline-block;background:var(--pink);color:var(--dark);border-radius:6px;font:800 10px var(--display);padding:1px 5px;margin-left:4px;vertical-align:1px}
.qty{display:flex;align-items:center;gap:6px}
.qty button{width:34px;height:34px;border-radius:10px;border:2px solid var(--line);background:var(--field);font-weight:800;font-size:18px;line-height:1}
.qty span{min-width:22px;text-align:center;font-weight:700}

.fields{display:grid;gap:8px;margin-top:10px}
.fld{display:grid;gap:3px;font-size:13px;font-weight:700}
.fld input,.num{width:100%;padding:10px 12px;border:2px solid var(--line);border-radius:12px;background:var(--field);color:var(--ink);font-size:16px;font-family:var(--body)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.row .num{width:96px;text-align:right;padding:7px 10px}
.sum{display:grid;gap:7px;margin-top:12px}
.totalbox{margin-top:10px;background:var(--acc);color:var(--dark);border:3px solid var(--line);border-radius:18px;box-shadow:4px 4px 0 var(--sh);padding:12px 16px;transform:rotate(-1.2deg);display:flex;justify-content:space-between;align-items:center}
.totalbox span{font-weight:700}
.totalbox b{font:800 26px var(--display);letter-spacing:-.02em}
.totalbox.pop b{animation:pop .25s}
@keyframes pop{50%{transform:scale(1.12)}}
.methods{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:14px}
.m{border:2px solid var(--line);background:var(--paper);border-radius:12px;padding:10px;font-weight:700}
.m[aria-pressed="true"]{background:var(--violet);color:#fff}
.cash{margin-top:10px;display:none;gap:8px}
.cash.on{display:grid}
.change{font-weight:800;color:var(--good)}
.change.bad{color:var(--bad)}
.msg{min-height:20px;font-size:13px;font-weight:700;color:var(--bad);margin-top:8px}
.actions{display:grid;grid-template-columns:1fr 1.6fr;gap:10px;margin-top:6px}
.btn{border:3px solid var(--line);border-radius:14px;padding:13px;font:800 15px var(--display);box-shadow:3px 3px 0 var(--sh);transition:transform .1s,box-shadow .1s;color:var(--dark)}
.btn:active:not(:disabled){transform:translate(3px,3px);box-shadow:0 0 0 var(--sh)}
.btn.sec{background:var(--paper);color:var(--ink);font-size:13px}
.btn.pay{background:var(--lime)}
.btn:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}

#bar{display:none}
.hbtn{background:var(--paper);color:var(--ink);font-family:var(--body);text-align:center}
.hbtn b{font-size:18px}
.hist{background:var(--paper);color:var(--ink);width:100%;max-width:420px;max-height:88%;overflow-y:auto;border:3px solid var(--line);border-radius:20px;box-shadow:6px 6px 0 var(--sh);padding:18px}
.hist h3{margin:0 0 10px;font:800 18px var(--display)}
.hrow{width:100%;display:flex;justify-content:space-between;align-items:center;gap:10px;text-align:left;background:var(--field);border:2px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:8px}
.hrow small{display:block;color:var(--muted);font-size:12px}
.hbtns{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.mode{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:10px;background:var(--field);border:3px solid var(--line);border-radius:14px;padding:4px}
.mode button{border:0;background:transparent;border-radius:10px;padding:9px 6px;font:700 13px var(--display);color:var(--ink)}
.mode button[aria-pressed="true"]{background:var(--violet);color:#fff}
.prod .gw{font-size:12px;font-weight:700;color:var(--good)}
.overlay{position:fixed;inset:0;background:rgba(10,5,30,.7);display:none;align-items:center;justify-content:center;padding:16px;z-index:10}
.overlay.on{display:flex}
.receipt{background:#fff;color:#14101F;width:100%;max-width:350px;max-height:100%;overflow-y:auto;border:3px solid #14101F;border-radius:16px;padding:20px 18px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;box-shadow:6px 6px 0 #000}
.receipt h3{margin:0;text-align:center;font:800 17px var(--display);letter-spacing:-.02em}
.receipt .c{text-align:center;color:#554D70}
.receipt hr{border:0;border-top:2px dashed #9A90BC;margin:10px 0}
.receipt .r{display:flex;justify-content:space-between;gap:8px}
.receipt .big{font-size:16px;font-weight:700}
.receipt svg{display:block;margin:10px auto 4px;width:96px;height:96px}
.rbtns{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.rbtns .btn{padding:10px;font-size:12px;background:#EDE7FF;color:#14101F;border-color:#14101F;box-shadow:2px 2px 0 #14101F}
.rbtns .btn.pri{grid-column:1/-1;background:#C6F432;font-size:13px}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;font-weight:700;opacity:0;pointer-events:none;transition:opacity .2s;z-index:20;max-width:90%;text-align:center}
.toast.on{opacity:1}

@media (max-width:880px){
  .app{grid-template-columns:1fr;padding:6px 12px 100px}
  .cart{position:static}
  .stat span{display:none}
  .stat.alt{display:none}
  #bar{display:flex;position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));background:var(--violet);color:#fff;justify-content:space-between;align-items:center;border:3px solid var(--line);border-radius:16px;box-shadow:4px 4px 0 var(--sh);padding:13px 16px;font:800 15px var(--display);z-index:5}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

.subbar{background:var(--sun);color:var(--dark);border-bottom:3px solid var(--line);padding:10px 16px;font-weight:700;text-align:center}
.subbar.bad{background:var(--bad);color:#fff}
.center{min-height:100vh;display:grid;place-items:center;padding:20px}
.lcard{width:100%;max-width:400px;padding:26px;display:grid;gap:14px}
.lcard h1{font:800 24px var(--display);letter-spacing:-.03em;margin:0}
.lcard p{margin:0;color:var(--muted)}
.lcard .brand{margin-bottom:6px}
.lcard code{background:var(--field);border:2px solid var(--line);border-radius:8px;padding:1px 6px;font-size:13px}
.fld select{width:100%;padding:10px 12px;border:2px solid var(--line);border-radius:12px;background:var(--field);color:var(--ink);font-size:16px;font-family:var(--body)}
.chk{display:flex;align-items:center;gap:10px;font-weight:700;font-size:14px;margin-top:8px}
.chk input{width:20px;height:20px;accent-color:var(--violet)}
.hbtns.one{grid-template-columns:1fr}
.hist h4{font:800 14px var(--display);margin:16px 0 8px}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.kpi{background:var(--sun);color:var(--dark);border:3px solid var(--line);border-radius:14px;padding:8px 8px;box-shadow:3px 3px 0 var(--sh)}
.kpi b{font:800 14px var(--display);display:block;word-break:break-word}
.kpi span{font-size:11px;font-weight:500}
.rbar{display:grid;grid-template-columns:90px 1fr auto;align-items:center;gap:8px;margin-bottom:8px;font-size:14px;position:static;background:none;border:0;box-shadow:none;padding:0;color:inherit}
.rbar i{display:block;height:16px;background:var(--acc,var(--violet));border:2px solid var(--line);border-radius:8px;min-width:3px}
.mini{display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:2px dashed var(--line)}
.lowt{color:var(--bad)}
.sub{color:var(--muted);font-size:13px;margin:0 0 10px}
.chatlog{max-height:46vh;min-height:90px;overflow-y:auto;display:grid;gap:8px;align-content:start;padding:4px 2px;margin-bottom:8px}
.bub{max-width:88%;padding:9px 12px;border:2px solid var(--line);border-radius:14px;white-space:pre-wrap;font-size:14px;line-height:1.4}
.bub.me{justify-self:end;background:var(--violet);color:#fff;border-bottom-right-radius:4px}
.bub.ai{justify-self:start;background:var(--field);border-bottom-left-radius:4px}
.qchips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.qchips .cat{font-size:12px;padding:5px 10px;text-align:left}
.chatin{display:grid;grid-template-columns:1fr auto;gap:8px}
.chatin input{padding:10px 12px;border:2px solid var(--line);border-radius:12px;background:var(--field);color:var(--ink);font-size:16px;font-family:var(--body)}
.who{font-size:12px;color:var(--muted);display:block}
.stats{flex-wrap:wrap;justify-content:flex-end}
@media (max-width:880px){
  #bar{display:flex;position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));background:var(--violet);color:#fff;justify-content:space-between;align-items:center;border:3px solid var(--line);border-radius:16px;box-shadow:4px 4px 0 var(--sh);padding:13px 16px;font:800 15px var(--display);z-index:5}
}
@media print{
  body>*:not(#ov){display:none!important}
  #ov{position:static;background:none;display:block!important;padding:0}
  .receipt{box-shadow:none;border:0;max-width:none;max-height:none}
  .rbtns{display:none}
}

/* intro video */
#intro{position:fixed;inset:0;z-index:99;background:linear-gradient(135deg,#2B1B5A,#14101F);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;text-align:center;padding:24px;animation:introOut .6s ease 4.4s forwards}
#intro .lg{width:96px;height:96px;border-radius:26px;background:var(--violet);display:grid;place-items:center;font:800 52px/1 system-ui,sans-serif;animation:pop .9s cubic-bezier(.2,1.4,.4,1) both}
#intro .w{font-size:16px;letter-spacing:.3em;text-transform:uppercase;opacity:0;animation:rise .8s ease .7s forwards}
#intro h2{font-size:clamp(28px,7vw,52px);margin:0;opacity:0;animation:rise .8s ease 1.3s forwards}
#intro .bar{width:min(240px,60vw);height:4px;background:rgba(255,255,255,.2);border-radius:4px;overflow:hidden}
#intro .bar i{display:block;height:100%;width:0;background:#fff;animation:fill 4s linear .4s forwards}
#intro button{background:none;border:2px solid rgba(255,255,255,.5);color:#fff;border-radius:999px;padding:8px 18px;font:inherit;cursor:pointer}
@keyframes pop{from{transform:scale(0) rotate(-20deg)}to{transform:none}}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes fill{to{width:100%}}
@keyframes introOut{to{opacity:0;visibility:hidden}}
@media (prefers-reduced-motion:reduce){#intro .w,#intro h2{opacity:1}#intro .bar i{width:100%}}
/* telefòn · tablèt · laptòp · òdinatè */
@media (min-width:600px) and (max-width:880px){.app{padding:10px 24px 100px}.lcard{max-width:460px}}
@media (min-width:1400px){.top,.app{max-width:1500px}.app{grid-template-columns:1fr 440px}}
/* ===== v2 ===== */
