.pic img{width:100%;height:100%;object-fit:cover}
.pic.sq{border-radius:18px}
.kpis.one{grid-template-columns:1fr}
.mode.k3{grid-template-columns:repeat(3,1fr)}
.bal{font:800 13px var(--display);white-space:nowrap}
.bal.owe{color:var(--bad)}
.bal.ok{color:var(--good)}
.tag.ref{background:var(--bad);color:#fff}
.feed .it{display:grid;gap:2px;padding:8px 0;border-bottom:2px dashed var(--line)}
.feed .it small{color:var(--muted)}
.team{background:var(--field);border:2px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:10px;display:grid;gap:6px}
.hist textarea{width:100%}
.btn.sm{padding:9px 14px;font-size:13px}
.plans{display:grid;gap:10px}.plan{width:100%;text-align:left;border:3px solid var(--line);background:var(--paper);border-radius:16px;padding:12px 14px;box-shadow:3px 3px 0 var(--sh);display:flex;justify-content:space-between;align-items:center;gap:8px}.plan[aria-pressed="true"]{background:var(--lime);color:var(--dark)}.plan b{font:800 15px var(--display)}.plan small{display:block;opacity:.75}.hlp{text-align:center;font-size:13px}

/* ---------- À Propos ---------- */
#login{align-content:center;gap:20px}
.abt{width:100%;max-width:400px;padding:26px;display:grid;gap:16px}
.abt h2{font:800 20px var(--display);letter-spacing:-.03em;margin:0}
.abt h3{font:800 15px var(--display);margin:0;letter-spacing:-.02em}
